# Production Environment Configuration
# Copy this to .env in production and update with actual values

PORT=3000
NODE_ENV=production

# Backend URL (production domain)
BACKEND_URL=https://your-backend-domain.com

# Force HTTPS protocol for production
REQUIRE_HTTPS=true

# Frontend URL for redirects
FRONTEND_URL=https://your-frontend-domain.com

# CORS Whitelist (production domains)
CORS_WHITELIST=https://your-domain.com,https://app.your-domain.com,https://auth.your-domain.com,https://www.your-domain.com

# Cookie Domain (for cross-subdomain cookies)
COOKIE_DOMAIN=.your-domain.com

# Supabase Configuration (replace with your values)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Secret (generate a strong key)
JWT_SECRET=your-production-jwt-secret-key-min-32-chars

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Brevo Email Service
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME="Your Service Name"
