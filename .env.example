# ========================================
# S-Auth Microservice - Environment Variables
# Version: 1.0.2
# ========================================

# ----------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------
PORT=3000
NODE_ENV=development

# Backend URL (used for email verification redirects)
BACKEND_URL=http://localhost:3000

# Force HTTPS protocol (set to 'true' for production domains)
# When true, all callbacks and redirects will use https://
REQUIRE_HTTPS=false

# ----------------------------------------
# FRONTEND URL
# ----------------------------------------
# Used for email verification redirects
# Development: http://localhost:3000
# Production: https://your-domain.com
FRONTEND_URL=http://localhost:3000

# ----------------------------------------
# CORS CONFIGURATION
# ----------------------------------------
# Comma-separated list of allowed origins
# Development example:
CORS_WHITELIST=http://localhost:3000,http://localhost:5173,http://localhost:8080
# Production example:
# CORS_WHITELIST=https://yourdomain.com,https://app.yourdomain.com,https://www.yourdomain.com

# Cookie domain (leave empty for localhost)
# Development: (empty)
# Production: .yourdomain.com
COOKIE_DOMAIN=

# ----------------------------------------
# NEON POSTGRESQL DATABASE
# ----------------------------------------
# Get your connection string from: Neon Dashboard → Connection Details
# Format: postgres://user:password@hostname.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://user:password@hostname.neon.tech/neondb?sslmode=require

# ----------------------------------------
# JWT SECRET
# ----------------------------------------
# Generate a strong 512-bit random string
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-key-min-64-chars

# ----------------------------------------
# GOOGLE OAUTH CREDENTIALS
# ----------------------------------------
# Get these from: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ----------------------------------------
# BREVO (SENDINBLUE) EMAIL SERVICE
# ----------------------------------------
# Get these from: Brevo Dashboard → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=S-Auth

# ----------------------------------------
# OPTIONAL: RATE LIMITING
# ----------------------------------------
# Maximum requests per window
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000

# ----------------------------------------
# OPTIONAL: LOGGING
# ----------------------------------------
# LOG_LEVEL=info
# LOG_FILE=logs/auth.log

# ----------------------------------------
# NOTES
# ----------------------------------------
# 1. Never commit this file with real credentials
# 2. Copy to .env and fill in your actual values
# 3. Keep .env in .gitignore
# 4. Use different values for dev/staging/production
# 5. Rotate secrets regularly
